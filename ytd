#!/usr/bin/bash

CONFIG="$HOME/.config/yt-dlp/config"
DEFAULT_DIR="$HOME/downloads"

cleanup() {
  printf "\n\nInterrupted. Exiting...\n"
  exit 0
}
trap cleanup SIGINT

initialize_config() {
  if [[ ! -f "$CONFIG" ]]; then
    mkdir -p "$(dirname "$CONFIG")"
  elif ! grep -q "^-o" "$CONFIG"; then
    echo "-o $DEFAULT_DIR/%(title)s.%(ext)s" >> "$CONFIG"
  fi
}
initialize_config

get_download_dir() {
  if [[ -f "$CONFIG" ]] && grep -q "^-o" "$CONFIG"; then
    grep "^-o" "$CONFIG" | sed 's/-o //' | sed 's/%(title)s.*//'
  fi
}

set_download_dir() {
  read -rp "Enter new directory path (relative to HOME directory): " newdir
  new_download_dir="$HOME/$newdir"

  mkdir -p "$new_download_dir"

  if [[ -f "$CONFIG" ]] && grep -q "^-o" "$CONFIG"; then
    sed -i "s|^-o .*|-o $new_download_dir/%(title)s.%(ext)s|" "$CONFIG"
  fi
}

# ====== Handle arguments ===== #
if [[ "$#" != 0 ]]; then
  for arg in "$@"; do
    case "$arg" in
      "--help")
        printf "ytd - yt-dlp wrapper\n"
        printf "%-20s %s\n" "--help" "Display this help menu"
        printf "%-20s %s\n" "--get-dir" "Display the current download directory path"
        printf "%-20s %s\n" "--set-dir" "Change the download directory path"
        ;;

      "--get-dir")
        current_download_dir=$(get_download_dir)
        echo "All media is saved to: $current_download_dir"
        ;;

      "--set-dir")
        set_download_dir
        echo "Download directory changed successfully"
        ;;

      *)
        printf "Invalid argument. Try --help for more information\n"
        exit 1
        ;;
    esac
  done

  exit 0
fi

options=(
"Download video"
"Download audio (MP3)"
"Download video + audio"
"Exit"
)

DOWNLOAD_DIR=$(get_download_dir)
mkdir -p "$DOWNLOAD_DIR"

choice=$(printf "%s\n" "${options[@]}" | fzf --prompt="Select option > " --layout=reverse)

case "$choice" in

  "${options[0]}")
    printf "Video only\n"
    read -rp "Enter URL: " url
    yt-dlp -f "bv*[ext=mp4]" --merge-output-format mp4 "$url"
    echo "Saved to $DOWNLOAD_DIR"
    ;;

  "${options[1]}")
    printf "Audio only\n"
    read -rp "Enter URL: " url
    yt-dlp -x --audio-format mp3 "$url"
    echo "Saved to $DOWNLOAD_DIR"
    ;;

  "${options[2]}")
    printf "Video + Audio\n"
    read -rp "Enter URL: " url
    yt-dlp -f "bv*[ext=mp4]+ba[ext=m4a]/b[ext=mp4] / bv*+ba/b" --merge-output-format mp4 "$url"
    echo "Saved to $DOWNLOAD_DIR"
    ;;

  "${options[3]}")
    exit 0
    ;;

esac

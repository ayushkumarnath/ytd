#!/usr/bin/bash

CONFIG="$HOME/.config/yt-dlp/config"
DEFAULT_DIR="$HOME/downloads"
YT_DLP_STATUS=0

# Colors
RED='\033[0;31m'
RESET='\033[0m'

# Download types
declare -r -A DOWNLOAD=( [VIDEO_ONLY]="Download video" [AUDIO_ONLY]="Download audio (MP3)" [AUDIO_VIDEO]="Download video + audio" )

# Options presented to the user
options=(
"${DOWNLOAD[VIDEO_ONLY]}"
"${DOWNLOAD[AUDIO_ONLY]}"
"${DOWNLOAD[AUDIO_VIDEO]}"
"Exit"
)

cleanup() {
  printf "\n\nInterrupted. Exiting...\n"
  exit 0
}
trap cleanup SIGINT

initialize_config() {
  if [[ ! -f "$CONFIG" ]]; then
    mkdir -p "$(dirname "$CONFIG")"
    echo "-o $DEFAULT_DIR/%(title)s.%(ext)s" > "$CONFIG"
  elif ! grep -q "^-o" "$CONFIG"; then
    echo "-o $DEFAULT_DIR/%(title)s.%(ext)s" >> "$CONFIG"
  fi
}
initialize_config

get_download_dir() {
  if [[ -f "$CONFIG" ]] && grep -q "^-o" "$CONFIG"; then
    grep "^-o" "$CONFIG" | sed 's/-o //' | sed 's/%(title)s.*//'
  fi
}

set_download_dir() {
  read -rp "Enter new directory path (relative to HOME directory): " newdir
  new_download_dir="$HOME/$newdir"

  mkdir -p "$new_download_dir"

  if [[ -f "$CONFIG" ]] && grep -q "^-o" "$CONFIG"; then
    sed -i "s|^-o .*|-o $new_download_dir/%(title)s.%(ext)s|" "$CONFIG"
  fi
}

require() {
  if ! command -v "$1" >/dev/null 2>&1; then
    missing_deps+=("$1")
  fi
}

download() {
  read -rp "Enter URL: " url

  case "$1" in
    "${DOWNLOAD[VIDEO_ONLY]}")
      yt-dlp -f "bv*[ext=mp4]" --merge-output-format mp4 "$url"
    ;;
    "${DOWNLOAD[AUDIO_ONLY]}")
      yt-dlp -x --audio-format mp3 "$url"
    ;;
    "${DOWNLOAD[AUDIO_VIDEO]}")
      yt-dlp -f "bv*[ext=mp4]+ba[ext=m4a]/b[ext=mp4] / bv*+ba/b" --merge-output-format mp4 "$url"
    ;;
  esac

  YT_DLP_STATUS=$?
}

print_help() {
  printf "ytd - yt-dlp wrapper\n\n"

  printf "Usage: ytd [OPTION]\n\n"

  printf "Options:\n"
  printf "%-24s %s\n" "-h, --help" "Display this help menu"
  printf "%-24s %s\n" "-gd, --get-dir" "Display the current download directory path"
  printf "%-24s %s\n" "-sd, --set-dir" "Set/Change the download directory path"
}

print_error() {
  printf "Error: %s\n" "$1" >&2
  printf "See --help for more info\n" >&2
}

# ====== Argument parsing ===== #
# This program is supposed to accept only single argument
if [[ $# -gt 1 ]]; then
  print_error "this program accepts only single option"
  exit 1
elif [[ $# -eq 1 ]]; then
  case "$1" in
    "-h" | "--help")
      print_help
      exit 0
      ;;

    "-gd" | "--get-dir")
      current_download_dir=$(get_download_dir)
      echo "All media is saved to: $current_download_dir"
      exit 0
      ;;

    "-sd" | "--set-dir")
      set_download_dir
      echo "Download directory changed successfully"
      exit 0
      ;;

    *)
      print_error "unknown option '$1'"
      exit 1
      ;;
  esac
fi

# Dependency checks
deps=("yt-dlp" "ffmpeg" "node" "fzf")
missing_deps=()
for dep in "${deps[@]}"; do
  require "$dep"
done

if [[ ${#missing_deps[@]} -ne 0 ]]; then
  for dep in "${missing_deps[@]}"; do
    printf "${RED}Error:${RESET} dependency '%s' not found\n" "$dep" >&2
  done
  printf "Please install the required dependencies\n\n" >&2
  exit 1
fi

# Program starts
DOWNLOAD_DIR=$(get_download_dir)
mkdir -p "$DOWNLOAD_DIR"

choice=$(printf "%s\n" "${options[@]}" | fzf --prompt="Select option > " --layout=reverse)

case "$choice" in

  "${options[0]}")
    printf "Video only\n"
    download "${options[0]}"
    ;;

  "${options[1]}")
    printf "Audio only\n"
    download "${options[1]}"
    ;;

  "${options[2]}")
    printf "Video + Audio\n"
    download "${options[2]}"
    ;;

  "${options[3]}")
    exit 0
    ;;

esac

if [[ $YT_DLP_STATUS -eq 0 ]]; then
  echo "Saved to $DOWNLOAD_DIR"
  exit 0
else
  echo "Error occurred"
  exit 1
fi
